# MVPJS Environment Variables Configuration
# Copy this file to .env or .env.dev, .env.staging, .env.prod

# ============================================
# Application Environment
# ============================================
NODE_ENV=development
BASE=/

# ============================================
# Paths Configuration
# ============================================
SERVER_PATH=src/backend
CLIENT_PATH=src/frontend
OUT_DIR=dist
PUBLIC_DIR=public

# ============================================
# HTTP Configuration
# ============================================
HTTP_TIMEOUT=30000
HTTP_RETRIES=3

# ============================================
# Cache Configuration
# ============================================
CACHE_TYPE=localStorage
CACHE_TTL=3600000


# ============================================
# Build Configuration
# ============================================
BUILD_MODE=fullstack
